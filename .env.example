# ── DATABASE ────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/devcraft?sslmode=require"

# ── API ─────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
JWT_SECRET="change-this-to-a-long-random-string-min-32-chars"
JWT_REFRESH_SECRET="another-long-random-string-for-refresh-tokens"
CORS_ORIGIN="http://localhost:3000"

# ── ADMIN ────────────────────────────────────────────
ADMIN_EMAIL="you@yourdomain.com"
ADMIN_PASSWORD_HASH=""   # generate: node -e "require('bcryptjs').hash('yourpassword',12).then(console.log)"

# ── EMAIL (SMTP / Nodemailer) ─────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="DevCraft <hello@yourdomain.com>" # optional; falls back to SMTP_USER if it's an email address
EMAIL_REPLY_TO="you@yourdomain.com" # optional
EMAIL_TEST_TO="you@yourdomain.com" # non-production email sink; leave empty to send to the requested recipient

# ── MEDIA (Cloudinary) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET="devcraft_unsigned"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="" # same Cloudinary cloud name, exposed for client upload URLs

# ── NEXT.JS (web app) ────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ── AI (OpenRouter) ──────────────────────────────────────────────
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
