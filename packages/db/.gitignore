# ==========================================
# 4. Prisma / Database (packages/db)
# ==========================================
# packages/db compiled output built alongside source (should be in dist/ but legacy artifacts)
packages/db/index.js
packages/db/index.js.map
packages/db/index.d.ts
packages/db/index.d.ts.map

# packages/db scratch / ad-hoc migration files outside prisma/migrations/
packages/db/migration.sql
packages/db/*.sql
!packages/db/prisma/migrations/**/*.sql

# Prisma generated client (usually regenerated, unless you commit it)
packages/db/prisma/generated/
packages/db/generated/
packages/db/node_modules/.prisma/
packages/db/node_modules/@prisma/

# Prisma Studio local state
.prisma/

# Database files
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sql.bak

